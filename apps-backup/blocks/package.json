    "@wordpress/interactivity-router": "latest",
    "@yay-bulk-order/utils": "workspace:*",
    "@yay-bulk-order/view": "workspace:*"
  },
  "devDependencies": {
    "@types/wordpress__block-editor": "latest",
    "@types/wordpress__blocks": "latest",
    "@wordpress/scripts": "^31.2.0",
    "@yay-bulk-order/common": "workspace:*"
  }
