{
  "name": "@yay-bulk-order/blocks-pro",
  "version": "0.1.0",
  "description": "Pro Gutenberg blocks for Yay Bulk Order",
  "author": "YayCommerce",
  "scripts": {
    "dev": "pnpm run dev:variant-table",
    "dev:variant-table": "wp-scripts start --config webpack.config.cjs --source-path=./src/variant-table --output-path=../../assets/dist/blocks-pro/variant-table --blocks-manifest --experimental-modules",
    "build": "pnpm run build:variant-table",
    "build:variant-table": "wp-scripts build --config webpack.config.cjs --source-path=./src/variant-table --output-path=../../assets/dist/blocks-pro/variant-table --blocks-manifest --experimental-modules",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update"
  },
  "dependencies": {
    "@wordpress/block-editor": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/components": "latest",
    "@wordpress/compose": "latest",
    "@wordpress/data": "latest",
    "@wordpress/hooks": "latest",
    "@wordpress/i18n": "latest",
    "@wordpress/icons": "latest",
    "@wordpress/interactivity": "latest",
    "@wordpress/interactivity-router": "latest",
    "@yay-bulk-order/variant-table-store": "workspace:*"
  },
  "devDependencies": {
    "@types/wordpress__block-editor": "latest",
    "@yay-bulk-order/common": "workspace:*"
  }
}
