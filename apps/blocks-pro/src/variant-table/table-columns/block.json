{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yay-bulk-order/variant-table-columns",
  "version": "0.1.0",
  "title": "Variant Table Columns",
  "category": "woocommerce",
  "description": "One row per variation, in this column order.",
  "textdomain": "yay-bulk-order",
  "usesContext": ["postId", "yay-bulk-order/variantProductId"],
  "supports": {
    "interactivity": true,
    "inserter": false,
    "reusable": false,
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    }
  },
  "ancestor": ["yay-bulk-order/variant-table-root"],
  "parent": ["yay-bulk-order/variant-table"],
  "allowedBlocks": [
    "yay-bulk-order/variant-table-column-product",
    "yay-bulk-order/variant-table-column-sku",
    "yay-bulk-order/variant-table-column-description",
    "yay-bulk-order/variant-table-column-quantity",
    "yay-bulk-order/variant-table-column-subtotal",
    "yay-bulk-order/variant-table-column-select"
  ],
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
