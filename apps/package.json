{
  "name": "yay-bulk-order-workspace",
  "description": "Monorepo Workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "keywords": [
    "YayBulkOrder"
  ],
  "author": "YayCommerce",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --parallel run dev",
    "dev:admin": "pnpm --filter 'yay-bulk-order-admin-page' run dev",
    "dev:blocks": "pnpm --filter 'yay-bulk-order-blocks' run dev",
    "dev:packages": "pnpm --parallel --filter '@yay-bulk-order/*' run dev",
    "build": "pnpm -r --workspace-concurrency=Infinity run build",
    "build:admin": "pnpm --filter 'yay-bulk-order-admin-page' run build",
    "build:blocks": "pnpm --filter 'yay-bulk-order-blocks' run build",
    "build:packages": "pnpm --filter '@yay-bulk-order/*' run build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/wordpress__blocks": "^12.5.18",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wordpress/dependency-extraction-webpack-plugin": "next",
    "@wordpress/scripts": "^31.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.3",
    "terser": "^5.39.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vite-plugin-external": "^6.1.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "<THIRD_PARTY_MODULES>",
      "^@wordpress/(.*)$",
      "",
      "^@yay-bulk-order/(.*)$",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/styles/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": false,
    "importOrderSortSpecifiers": true,
    "importOrderBuiltinModulesToTop": true,
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ],
    "importOrderMergeDuplicateImports": true,
    "importOrderCombineTypeAndValueImports": true,
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./admin-page/src/main.css"
  }
}
