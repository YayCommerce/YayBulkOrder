{
  "name": "@yay-bulk-order/blocks",
  "version": "0.1.0",
  "description": "Gutenberg blocks for Yay Bulk Order",
  "author": "YayCommerce",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:product-table\" \"pnpm run dev:common\"",
    "dev:product-table": "wp-scripts start --config webpack.config.cjs --source-path=./src/product-table --output-path=../../assets/dist/blocks/product-table --blocks-manifest --experimental-modules",
    "dev:common": "wp-scripts start --config webpack.config.cjs --source-path=./src/common --output-path=../../assets/dist/blocks/common --blocks-manifest --experimental-modules",
    "build": "pnpm run build:product-table && pnpm run build:common",
    "build:product-table": "wp-scripts build --config webpack.config.cjs --source-path=./src/product-table --output-path=../../assets/dist/blocks/product-table --blocks-manifest --experimental-modules",
    "build:common": "wp-scripts build --config webpack.config.cjs --source-path=./src/common --output-path=../../assets/dist/blocks/common --blocks-manifest --experimental-modules",
    "build:manifest": "wp-scripts build-blocks-manifest --input=src --output=../../assets/dist/blocks/blocks-manifest.php",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update"
  },
  "dependencies": {
    "@wordpress/block-editor": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/components": "latest",
    "@wordpress/compose": "latest",
    "@wordpress/data": "latest",
    "@wordpress/hooks": "latest",
    "@wordpress/i18n": "latest",
    "@wordpress/icons": "latest",
    "@wordpress/interactivity": "latest",
    "@wordpress/interactivity-router": "latest",
    "@yay-bulk-order/common": "workspace:*",
    "@yay-bulk-order/product-table-store": "workspace:*",
    "@yay-bulk-order/variant-table-store": "workspace:*"
  },
  "devDependencies": {
    "@types/wordpress__block-editor": "latest",
    "concurrently": "^10.0.3"
  }
}
