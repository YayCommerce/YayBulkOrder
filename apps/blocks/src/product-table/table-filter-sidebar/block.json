{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yay-bulk-order/product-table-filter-sidebar",
  "version": "0.1.0",
  "title": "Table Filter Sidebar",
  "category": "woocommerce",
  "description": "Product category list toggled by the Table Filter Button.",
  "textdomain": "yay-bulk-order",
  "usesContext": ["queryId"],
  "supports": {
    "interactivity": true,
    "inserter": false,
    "multiple": false,
    "reusable": false,
    "html": false,
    "anchor": true,
    "color": {
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    }
  },
  "ancestor": ["yay-bulk-order/product-table-root"],
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
