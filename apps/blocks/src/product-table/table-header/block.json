{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yay-bulk-order/product-table-header",
  "version": "0.1.0",
  "title": "Table Header",
  "category": "woocommerce",
  "description": "Product Table Header.",
  "textdomain": "yay-bulk-order",
  "attributes": {
    "columns": {
      "type": "array",
      "default": [
        { "name": "yay-bulk-order/product-table-column-product" },
        { "name": "yay-bulk-order/product-table-column-sku" },
        { "name": "yay-bulk-order/product-table-column-description" },
        { "name": "yay-bulk-order/product-table-column-quantity" },
        { "name": "yay-bulk-order/product-table-column-subtotal" },
        { "name": "yay-bulk-order/product-table-column-add-to-cart" },
        { "name": "yay-bulk-order/product-table-column-select" }
      ]
    }
  },
  "supports": {
    "interactivity": true,
    "inserter": false,
    "reusable": false,
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    }
  },
  "ancestor": ["yay-bulk-order/product-table-root"],
  "parent": ["yay-bulk-order/product-table"],
  "editorScript": "file:./editor.js"
}
