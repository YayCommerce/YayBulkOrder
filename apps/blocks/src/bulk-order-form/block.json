{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yay-bulk-order/bulk-order-form",
  "version": "0.1.0",
  "title": "Bulk Order Form",
  "category": "woocommerce",
  "icon": "cart",
  "description": "A block to show WooCommerce Products as Table optimized for bulk ordering.",
  "textdomain": "yay-bulk-order",
  "attributes": {
		"queryId": {
			"type": "number",
      "default": 0
		},
		"forcePageReload": {
			"type": "boolean",
			"default": false
		}
	},
  "providesContext": {
		"queryId": "queryId"
	},
  "supports": {
    "interactivity": true,
    "multiple": false,
    "align": [ "wide", "full" ],
    "anchor": true
  },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style-editor.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view-module.js",
  "viewScript": "file:./view.js"
}
