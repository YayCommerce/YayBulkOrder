{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yay-bulk-order/table-template",
  "version": "0.1.0",
  "title": "Bulk Order Table Template",
  "category": "woocommerce",
  "description": "A block to show WooCommerce Products as Table optimized for bulk ordering.",
  "textdomain": "yay-bulk-order",
  "usesContext": [ "queryId", "query" ],
  "supports": {
    "interactivity": true,
    "inserter": false,
    "multiple": false,
		"reusable": false,
    "html": false,
    "align": [ "wide", "full" ],
		"anchor": true,
    "color": {
			"gradients": true,
			"link": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
  },
  "ancestor": [
    "yay-bulk-order/bulk-order-form"
  ],
  "allowedBlocks": [
    "yay-bulk-order/product-title-column",
    "yay-bulk-order/product-price-column",
    "yay-bulk-order/product-stock-column"
  ],
  "editorScript": "file:./editor.js",
  "style": "file:./style-editor.css",
  "render": "file:./render.php"
}
